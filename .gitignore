.env
node_modules/
scripts/output/
.serena/

# Stage 2 discovery watched folder — real input location; contents are local
# only, but the folder structure is kept via .gitkeep.
discovery-inbox/*.eml
discovery-inbox/*.txt
discovery-inbox/processed/*
!discovery-inbox/processed/.gitkeep

# Wave 1 discovery scope — operator-specific confirmed state, generated by
# `oaos setup-scope`. Local only.
preferences.json

# Wave 4 D18 calendar sink — operator-local state, written by
# src/discovery/stage3/calendar-writer.ts. Read by humans, not the pipeline.
discovery/calendar.json

# Wave 6 Stage-3 source health — operator-local state, written by
# src/discovery/orchestrator/health-store.ts. Reset only via
# `oaos discover --stage3 --reenable <name>`.
discovery/health.json

# Wave 5 Remotive daily-call cap — operator-local state, written by
# src/discovery/stage3/query/remotive-state.ts. Enforces 1 API call per UTC
# day; a corrupt file throws rather than silently handing back a fresh budget.
discovery/remotive.json

research/phase0/adzuna-keys.txt
research/phase0c/adzuna-keys.txt
.DS_Store
**/.DS_Store
.codex/
AGENTS.md
research/phase1-eligibility/raw/

# Experience-eligibility probe captures (2026-08-07, 1.6 MB of Himalayas
# search responses). Same posture as phase1-eligibility/raw/: the scripts and
# the written findings are tracked, the bytes are not. Regenerate with
# `npx tsx research/experience-eligibility/capture.ts` — 13 live requests, and
# the corpus WILL have drifted. See that directory's README.md.
research/experience-eligibility/raw/
