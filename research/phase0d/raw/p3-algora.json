          "pull_request": {
            "url": "https://api.github.com/repos/mergeos-bounties/PlantGuide/pulls/148",
            "html_url": "https://github.com/mergeos-bounties/PlantGuide/pull/148",
            "diff_url": "https://github.com/mergeos-bounties/PlantGuide/pull/148.diff",
